# .env.local にコピーして使う（.env.local は git に含まれない）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# 公開用LPサイトとつなぐとき（docs/SETUP-LP.md）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# サーバー（Railway など）に置くときだけ使う。手順は docs/SETUP-SERVER.md
# DASHBOARD_PASSWORD=            # 設定すると、来た人は閲覧だけになり（見せないものは「デモ表示」で伏せる）、/login でこのパスワードを入れた人だけ操作できる
# AI_LAB_DB=/data/ai-lab.db      # データの保存先（サーバーのボリューム）
# TZ=Asia/Tokyo                  # 毎日の自動実行の時刻を日本時間で数える
# AI_LAB_SCHEDULER=off           # サーバーに移したあと、このPCでは自動実行と取り込みを止める
